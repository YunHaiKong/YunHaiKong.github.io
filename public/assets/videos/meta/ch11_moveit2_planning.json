 "scenes": [
  {
   "index": 0,
   "type": "title",
   "start": 0.0,
   "end": 15.033,
   "section": "",
   "narration": "机械臂的规划空间是七个关节角，不是一张平面地图。目标位姿确定后，规划器要在关节空间里找一条无碰撞、可执行、尽量短的轨迹。"
  },
  {
   "index": 1,
   "type": "image",
   "start": 15.033,
   "end": 30.833,
   "section": "规划与执行 · RViz",
   "narration": "这是 MoveIt2 在 RViz 里的规划与执行画面。左侧是机械臂与桌面场景，右侧是 RViz 的规划场景；规划成功后，轨迹会送进控制器逐点执行。"
  },
  {
   "index": 2,
   "type": "image",
   "start": 30.833,
   "end": 49.833,
   "section": "规划执行 · RViz 实时画面",
   "narration": "这是执行时的 RViz 视角。左边是 Isaac Sim 里的机械臂，右边是 PlanningScene：头部深度相机生成的点云、机械臂碰撞体和执行轨迹同时在线。规划结果直接送进控制器，不是离线动画。"
  },
  {
   "index": 3,
   "type": "image",
   "start": 49.833,
   "end": 66.3,
   "section": "规划场景 · 深度点云",
   "narration": "再放大 PlanningScene。桌面的彩色体素是碰撞场景的离散表示，机械臂与夹爪也作为碰撞体参与检查；规划器绕开的不是一张图片，而是这些真实占据的体素。"
  },
  {
   "index": 4,
   "type": "media",
   "start": 66.3,
   "end": 82.6,
   "section": "真实执行 · 抓取链",
   "narration": "规划不是离线动画。真实执行时，预抓取、下探、夹取、抬升每一步都要重新检查碰撞；轨迹点之间的关节增量必须满足速度与加速度限制。"
  },
  {
   "index": 5,
   "type": "chart",
   "start": 82.6,
   "end": 101.167,
   "section": "实验二 · 采样步长",
   "narration": "步长从 0.1 增到 0.45，规划耗时先降后升：0.22 时 22.85 毫秒，0.45 时反而 29.43 毫秒。步长太小会在狭窄通道里反复采样，太大又会频繁碰撞检查。"
  },
  {
   "index": 6,
   "type": "image",
   "start": 101.167,
   "end": 116.967,
   "section": "实验总览",
   "narration": "随机种子的影响更大。四次运行迭代次数从 5 到 48，原始轨迹长度从 0.905 到 3.168 弧度；捷径优化后，大多收敛到 0.7 到 1.1 弧度。"
  },
  {
   "index": 7,
   "type": "code",
   "start": 116.967,
   "end": 131.434,
   "section": "实现 · RRT-Connect",
   "narration": "RRT-Connect 从起点和终点各长一棵树，轮流扩展并尝试连接。找到连接点后回溯路径，再用捷径和关节平滑去掉多余绕行。"
  },
  {
   "index": 8,
   "type": "metrics",
   "start": 131.433,
   "end": 150.333,
   "section": "规划实验读数",
   "narration": "最慢的一次种子跑了 48 次迭代，原始路径 3.168 弧度，优化后 1.066 弧度；捷径平均缩短 44.8%。速度缩放从 0.5 到 1.5，执行时间从 5.59 秒降到 3.23 秒。"
  },
  {
   "index": 9,
   "type": "outro",
   "start": 150.333,
   "end": 163.066,
   "section": "",
   "narration": "导航解决‘到哪里’，规划解决‘怎么过去’，抓取解决‘怎么接触’。最后一章，我们把它们放进同一次任务里，不再分开演示。"
  }
